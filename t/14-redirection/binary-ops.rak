use Test;

plan 4;

# ---------------------------------------------------------------------------
# Binary-operator disambiguation: in rak syntax, binary operators are
# space-delimited. `>` touching a filename is redirection; `>` with
# spaces on both sides is the ordinary comparison operator.
# ---------------------------------------------------------------------------

# 1. Space before and after > means comparison, not output redirection.
#    `foo > bar` compares the two naked strings; it must never create a
#    file named bar. (Raku's > on strings fails at runtime, so probe via
#    EVAL; the invariant we check is that no file appears.)
{
    try { EVAL 'my $result = foo > bar;' }
    nok 'bar'.IO.e, '1: space-delimited > does not create a file';
    'bar'.IO.unlink if 'bar'.IO.e;
}

# 2. Hyperoperators with spaces still work: `>>+<<` applies elementwise,
#    nothing to do with file append.
{
    my @a = 1, 2, 3;
    my @b = @a >>+<< (10, 10, 10);
    is @b.join(' '), '11 12 13', '2: >>+<< with space is a hyperoperator, not redirection';
}

# 3. `>` in an infix position with spaces on both sides is never
#    redirection — even with a quoted RHS that looks like a filename.
{
    try { EVAL 'say "data" > unwanted.txt;' }
    nok 'unwanted.txt'.IO.e, '3: space after > does not redirect';
    'unwanted.txt'.IO.unlink if 'unwanted.txt'.IO.e;
}

# 4. A `>` that touches a quoted filename (no space) IS redirection.
{
    say 'should redirect' >'wanted.txt';
    is 'wanted.txt'->IO->slurp->trim, 'should redirect',
        '4: > directly touching a quoted filename redirects';
    'wanted.txt'->IO->unlink;
}

done-testing();