# test-dotty.rak — tests .name subscript syntax (rak mode)
# In .rak mode: .name = <name> subscript, ->name = parameterless method call

my %h = a => 1, b => 2, c => 3;
say %h.a;           # <a> — should give 1
say %h.b;           # <b> — should give 2

my @a = 10, 20, 30;
say @a.1;           # [1] — should give 20
say @a.2;           # [2] — should give 30

# Method calls need -> or explicit parentheses
say %h->keys;       # method call via ->
say %h.keys();      # method call with explicit parens